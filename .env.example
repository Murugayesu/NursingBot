# ============================================================================
# RAG Platform — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================================

# -- Application -------------------------------------------------------------
APP_ENV=development          # development | production
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
API_HOST=0.0.0.0
API_PORT=8000

# -- PostgreSQL ---------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rag
POSTGRES_PASSWORD=ragpassword
POSTGRES_DB=ragdb

# -- Qdrant -------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
# Leave blank if no auth on Qdrant
QDRANT_API_KEY=

# -- LLM — OpenAI-compatible API ----------------------------------------------
# Works with OpenAI, Azure OpenAI, vLLM, LM Studio, Ollama (/v1), etc.
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2048

# -- Embeddings ---------------------------------------------------------------
# bge_m3  → local BAAI/bge-m3 via FlagEmbedding (default)
# openai  → OpenAI text-embedding-3-small / text-embedding-3-large
EMBEDDING_PROVIDER=bge_m3
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu         # cpu | cuda | mps
EMBEDDING_BATCH_SIZE=32

# -- Reranker -----------------------------------------------------------------
# jina    → jinaai/jina-reranker-v2-base-multilingual (local, trust_remote_code)
# cross_encoder → sentence-transformers cross-encoder (local)
RERANKER_PROVIDER=jina
RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual
RERANKER_DEVICE=cpu          # cpu | cuda | mps

# -- Langfuse -----------------------------------------------------------------
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# -- Retrieval defaults -------------------------------------------------------
DEFAULT_DENSE_TOP_K=20
DEFAULT_SPARSE_TOP_K=20
DEFAULT_RERANKER_TOP_K=5
DEFAULT_CHUNK_SIZE=800
DEFAULT_CHUNK_OVERLAP=100
